# Backend settings on the hosted server: /etc/dateroem/backend.env
# (made from this file by setup-server.sh; owner root, group dateroem, mode 640).
# Hosting and Deployment Guide (DWS-CFG-03), "Values to fill in".
#
# Rules for this file: one NAME=value per line, no spaces around "=", no
# quotes, comments only on their own lines. After any change:
#   sudo systemctl restart dateroem-backend
#
# __DOMAIN__, __DB_PASSWORD__ and __JWT_SECRET__ are filled in by
# setup-server.sh. Everything else comes WITH THE RELEASE: the backend is built
# from the company computer's application.properties, so the live M-Pesa keys,
# the SMS settings and the worker data key arrive inside it (24 October 2026).
# A line here OVERRIDES what the release carries - so the lines for those
# values start with "#". Remove the "#" only to change one of them, and never
# leave a line as NAME= with nothing after it: that switches the value off.

# --- Server and database (filled in by setup-server.sh) --------------------
# Only Caddy talks to the backend, on this machine.
SERVER_ADDRESS=127.0.0.1
SPRING_DATASOURCE_URL=jdbc:mysql://127.0.0.1:3306/dateroem?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
SPRING_DATASOURCE_USERNAME=dateroem_backend
DATEROEM_DB_PASSWORD=__DB_PASSWORD__

# --- Sign-in (filled in by setup-server.sh) --------------------------------
# Signs every login token. Changing it signs everybody out once.
AUTH_JWT_SECRET=__JWT_SECRET__

# --- Worker details and documents (migration 040) -------------------------
# Comes with the release (app.workers.data-secret). Never put a NEW value here:
# the worker details already in the database can only be read with the key
# that encrypted them. Set it here only to copy that same key exactly.
# WORKER_DATA_SECRET=
# Google sign-in uses the Dateroem web client (application.properties).
# Add https://__DOMAIN__ to its "Authorised JavaScript origins".

# --- AI assistant ----------------------------------------------------------
# These keys are NOT in the release. Paste a new key made for this server
# (console.groq.com, then API Keys); while it is empty the assistant is off.
AI_CHAT_PROVIDER=groq
GROQ_API_KEY=
ANTHROPIC_API_KEY=

# --- M-Pesa customer payments (live since 16 October 2026) ------------------
# The live consumer key and secret, the passkey, the store (shortcode 1334200),
# the till (party B 1804074) and the payment type (CustomerBuyGoodsOnline) all
# come with the release. Change one only by removing its "#" and filling it in.
# MPESA_BASE_URL=https://api.safaricom.co.ke
# MPESA_CONSUMER_KEY=
# MPESA_CONSUMER_SECRET=
# MPESA_SHORTCODE=
# MPESA_PASSKEY=
# MPESA_TRANSACTION_TYPE=
# MPESA_PARTY_B=
# Where Safaricom posts each payment result: THIS server (the release still
# carries the old tunnel address). No "mpesa" in the address - Safaricom
# rejects callback addresses containing it.
MPESA_CALLBACK_URL=https://__DOMAIN__/api/dateroem-payments/stk

# --- M-Pesa Send Money (B2C): THE LINES TO FILL WHEN SAFARICOM PROVIDES IT ---
# Safaricom has to give a payout (B2C) shortcode, an API initiator (a user
# made on the M-Pesa organisation portal) and switch Send Money on for the
# Daraja app - a till can't pay out. Then fill these three lines and run
#   sudo systemctl restart dateroem-backend
# Until then they stay empty and Send Money is off (refunds are paid by hand).
MPESA_B2C_INITIATOR_NAME=
MPESA_B2C_INITIATOR_PASSWORD=
MPESA_B2C_SHORTCODE=
# Safaricom's production certificate - install-release.sh puts it here.
MPESA_B2C_CERT_PATH=/etc/dateroem/mpesa/ProductionCertificate.cer
MPESA_B2C_RESULT_URL=https://__DOMAIN__/api/dateroem-payments/b2c-result
MPESA_B2C_QUEUE_TIMEOUT_URL=https://__DOMAIN__/api/dateroem-payments/b2c-result

# --- SMS codes that confirm customers' phone numbers (Africa's Talking) -----
# Live for Airtel numbers since 17 October 2026. The username, API key, sender
# and networks come with the release.
# SMS_PROVIDER=africastalking
# SMS_USERNAME=
# SMS_API_KEY=
# When Dateroem's own sender name is approved: remove the "#" from the two
# lines below and set them (the approved name, and all).
# SMS_SENDER_ID=
# SMS_NETWORKS=airtel
