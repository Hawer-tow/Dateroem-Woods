# Backend settings on the hosted server: /etc/dateroem/backend.env
# (made from this file by setup-server.sh; owner root, group dateroem, mode 640).
# Hosting and Deployment Guide (DWS-CFG-03), "Values to fill in".
#
# Rules for this file: one NAME=value per line, no spaces around "=", no
# quotes, comments only on their own lines. After any change:
#   sudo systemctl restart dateroem-backend
#
# __DOMAIN__, __DB_PASSWORD__ and __JWT_SECRET__ are filled in by
# setup-server.sh. Empty values are filled in by you; while an M-Pesa value
# is empty, checkout uses the manual confirm flow, as before Go Live.

# --- Server and database (filled in by setup-server.sh) --------------------
# Only Caddy talks to the backend, on this machine.
SERVER_ADDRESS=127.0.0.1
SPRING_DATASOURCE_URL=jdbc:mysql://127.0.0.1:3306/dateroem?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
SPRING_DATASOURCE_USERNAME=dateroem_backend
DATEROEM_DB_PASSWORD=__DB_PASSWORD__

# --- Sign-in (filled in by setup-server.sh) --------------------------------
# Signs every login token. Changing it signs everybody out once.
AUTH_JWT_SECRET=__JWT_SECRET__
# Google sign-in uses the Dateroem web client (application.properties).
# Add https://__DOMAIN__ to its "Authorised JavaScript origins".

# --- AI assistant: new keys, not the ones used during development ----------
AI_CHAT_PROVIDER=groq
GROQ_API_KEY=
ANTHROPIC_API_KEY=

# --- M-Pesa: Safaricom Daraja PRODUCTION values (after Go Live) -------------
MPESA_BASE_URL=https://api.safaricom.co.ke
# From the production app on the Daraja portal.
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
# Paybill: the paybill number. Till: the store (head office) number that
# Safaricom gave the passkey for.
MPESA_SHORTCODE=
# Lipa na M-Pesa Online passkey, sent by Safaricom after Go Live.
MPESA_PASSKEY=
# Paybill: CustomerPayBillOnline. Till: CustomerBuyGoodsOnline.
MPESA_TRANSACTION_TYPE=CustomerPayBillOnline
# Till only: the till number customers pay into. Paybill: leave empty.
MPESA_PARTY_B=
# Where Safaricom posts each payment result. No "mpesa" in the address -
# Safaricom rejects callback addresses containing it.
MPESA_CALLBACK_URL=https://__DOMAIN__/api/dateroem-payments/stk

# --- M-Pesa Send Money (B2C) -----------------------------------------------
# API user created on the M-Pesa organisation portal, and its password.
MPESA_B2C_INITIATOR_NAME=
MPESA_B2C_INITIATOR_PASSWORD=
# The shortcode payouts are sent from.
MPESA_B2C_SHORTCODE=
# Safaricom's production certificate (download from the Daraja portal and
# copy it to this path).
MPESA_B2C_CERT_PATH=/etc/dateroem/mpesa/ProductionCertificate.cer
MPESA_B2C_RESULT_URL=https://__DOMAIN__/api/dateroem-payments/b2c-result
MPESA_B2C_QUEUE_TIMEOUT_URL=https://__DOMAIN__/api/dateroem-payments/b2c-result

# --- SMS codes that confirm customers' phone numbers (Africa's Talking) -----
# africastalking once the account below is ready; off = no codes (as before).
SMS_PROVIDER=africastalking
# The Africa's Talking app's username (not "sandbox") and its API key.
SMS_USERNAME=
SMS_API_KEY=
# The sender name approved by Africa's Talking, e.g. DATEROEM. Empty = their
# shared sender.
SMS_SENDER_ID=
# Which numbers get codes: airtel until Dateroem's own sender ID is approved
# (Africa's Talking's shared sender only reaches Airtel), then all.
SMS_NETWORKS=airtel
