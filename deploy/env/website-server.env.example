# Website server settings on the hosted server: /etc/dateroem/website-server.env
# (made from this file by setup-server.sh). After a change:
#   sudo systemctl restart dateroem-website-server
# One NAME=value per line, no quotes, comments on their own lines.

BACKEND_BASE_URL=http://127.0.0.1:8080

# "Send us an email" window: the business Gmail and an App Password made for
# THIS server (Google Account, Security, App passwords). Empty = the email
# buttons open the visitor's own email app instead.
SMTP_USER=dateroemwoodsales@gmail.com
SMTP_APP_PASSWORD=

# Contacts shown on the site. Remove the "#" to change one; the current
# values are the defaults in frontend/app/core/config.py. The phone number
# is the company number for calls and WhatsApp (Help page, Bulk Orders page,
# footer); write it as +254... or 07.../01... - the WhatsApp link is built
# from either. Restart the website server after a change.
#SUPPORT_PHONE=+254182995011
#SUPPORT_WHATSAPP=+254182995011
#SUPPORT_EMAIL=dateroemwoodsales+support@gmail.com
# Bulk (heavy) order enquiries - the Bulk Orders page shows this address and
# its email window writes to it.
#ORDERS_EMAIL=dateroemwoodsales+orders@gmail.com
#SUPPORT_TIKTOK=https://www.tiktok.com/@dateroem.woods
#SUPPORT_INSTAGRAM=https://www.instagram.com/dateroem.woods/
