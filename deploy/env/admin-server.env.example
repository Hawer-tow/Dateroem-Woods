# Desktop app server settings on the hosted server: /etc/dateroem/admin-server.env
# (made from this file by setup-server.sh). After a change:
#   sudo systemctl restart dateroem-admin-server

BACKEND_BASE_URL=http://127.0.0.1:8080
# Desktop copies older than this are asked to update before signing in.
MIN_DESKTOP_VERSION=1.1
