<?xml version="1.0" encoding="utf-8"?>
<!--
  Cleartext HTTP is allowed only for the two dev-only loopback addresses
  mobileServer is reached through (see RetrofitClient.kt): 10.0.2.2 for
  the emulator, 127.0.0.1 for a physical device over `adb reverse`.
  Before any real deployment, mobileServer needs a real HTTPS endpoint
  and this exception should be removed entirely rather than widened.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>
